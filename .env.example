# Network: "testnet" (default) or "mainnet"
MONAD_NETWORK=testnet

# 0.5% commission recipient
PAY_TO_ADDRESS=0xYOUR_WALLET_ADDRESS

# WalletConnect project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Port (default 3001 to avoid conflict with x402-defi-copilot on 3000)
PORT=3001

# Optional: override testnet QuoterV2 address if deployed
UV3_QUOTER_TESTNET=
